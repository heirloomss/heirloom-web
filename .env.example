# Frontend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Stellar network configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Demo data gate. Keep FALSE in production — when false, every API fallback is
# genuinely empty (no fabricated data is ever shown). Reviewers may set true to
# explore the full UX with no backend running.
NEXT_PUBLIC_DEMO_MODE=false
