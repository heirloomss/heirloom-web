# Don't run a full `pnpm install` before every `pnpm <script>` — it makes
# `pnpm dev` fail on machines that haven't pre-approved native build scripts.
verify-deps-before-run=false

# sharp and unrs-resolver ship prebuilt platform binaries via optional deps, so
# their node-gyp build scripts are not needed. Downgrade pnpm 10+'s hard
# ERR_PNPM_IGNORED_BUILDS gate to a warning so `pnpm install` succeeds
# unattended (they are also listed in pnpm-workspace.yaml onlyBuiltDependencies).
strict-dep-builds=false
